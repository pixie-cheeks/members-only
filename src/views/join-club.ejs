<% if (locals.currentUser.is_member) { %>
<div class="banner">
  <h1 class="banner__message">You have already joined the club!</h1>
  <a href="/" class="btn banner__btn">Go back home</a>
</div>
<% } else { %>
<form action="/join-club" method="POST" class="form">
  <%- include('partials/form-errors') %><br>
  <div class="form__container">
    <h1 class="form__title">Join Club</h1><br>
    <div class="form__field">
      <label for="password">Secret Club Password</label>
      <input type="password" name="password" id="password" class="form__input">
    </div>

    <button type="submit" class="btn form__btn">Join</button>
  </div>

</form>
<% } %>