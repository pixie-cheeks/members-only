<% const isAdmin = locals.currentUser?.is_admin %>
<% const canSee = locals.currentUser?.is_member || isAdmin %>

<div class="main__header">
  <% if (locals.currentUser) { %>
  <h1 class="main__heading">Hello, <%= currentUser.username %>!</h1>

  <a class="btn main__btn" href="/message/create">&plus; Add Message</a>
  <% } else { %>
  <h1 class="main__heading">Hello person!</h1>
  <% } %>
</div>

<% if (allMessages.length > 0) { %>
<ul class="cards">
  <% allMessages.reverse().forEach(({title, content, creation_time, first_name, last_name, username, message_id}) => { %>
  <li class="card">
    <% if (canSee) { %>
    <div class="card__author">
      <div class="card__media-like"><%= first_name.charAt(0) %></div>
      <div class="card__name-stuff">
        <p class="card__username"><%= username %></p>
        <p class="card__name"><%= `${first_name} ${last_name}`  %></p>
      </div>
    </div>
    <% } %>
    <div class="card__body">
      <div class="card__content">
        <h2 class="card__title"><%= title %></h2>
        <% if (canSee) { %>
        <p class="card__subtitle"><%=
        new Intl.DateTimeFormat("en-IN", {
          dateStyle: "medium",
          timeStyle: "long",
          timeZone: "UTC",
        }).format(new Date(creation_time))
      %></p>
        <% } %>
        <p class="card__text"><%= content %></p>
      </div>
      <% if (isAdmin) { %>
      <div class="card__actions">
        <form action="/message/delete" method="POST">
          <input type="hidden" name="message_id" value="<%= message_id %>">
          <button type="submit" class="btn card__btn">Delete Message</button>
        </form>
      </div>
      <% } %>
    </div>
  </li>

  <% }) %>

</ul>
<% } else { %>
<div class="main__content">
  <!-- <img src="/images/empty-state.webp" alt="" class="main__media"> -->
  <div class="main__empty-text">
    <p class="main__subtitle">Wow! Seems like nobody has added a message yet.</p>
  </div>
  <% if (locals.currentUser) { %>
  <a href="/message/create" class="main__btn btn">Add a Message</a>
  <% } %>
</div>
<% }%>