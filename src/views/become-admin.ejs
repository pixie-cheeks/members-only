<div style="max-width: 20rem; margin: 0 auto">
  <% if (locals.currentUser.is_admin) { %>
  <h1>You are already an admin!</h1>
  <a href="/">Go back home</a>
  <% } else { %>
  <h1>Join Club</h1><br>
  <%- include('partials/form-errors') %><br>
  <form action="/become-admin" method="POST">
    Admin Password: <br><input type="password" name="password"><br><br>

    <br><button type="submit">Submit</button>

  </form>
  <% } %>
</div>