<div style="max-width: 20rem; margin: 0 auto">
  <h1>Sign Up</h1><br>
  <%- include('partials/form-errors') %><br>
  <form action="/sign-up" method="POST">
    First Name: <br><input type="text" name="first_name"><br><br>
    Last Name: <br><input type="text" name="last_name"><br><br>
    Username: <br><input type="text" name="username"><br><br>
    Password: <br><input type="password" name="password"><br><br>
    Confirm Password: <br><input type="password" name="confirm_password"><br><br>

    <br><button type="submit">Submit</button>

  </form>
</div>