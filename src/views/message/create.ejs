  <form action="/message/create" method="POST" class="form">
    <%- include('../partials/form-errors') %><br>
    <div class="form__container">
      <h1 class="form__title">Create Message</h1>

      <div class="form__field">
        <label for="title">Title</label>
        <input type="text" name="title" id="title" class="form__input">
      </div>

      <div class="form__field">
        <label for="content">Content</label>
        <textarea name="content" id="content" class="form__input form__input--textarea"></textarea>
      </div>

      <button type="submit" class="btn form__btn">Save Message</button>
    </div>

  </form>